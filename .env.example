# Postgres connection string (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Max accepted upload size in bytes (defensive limit for the Lambda handler)
MAX_UPLOAD_BYTES=5242880

# Frontend: base URL of the deployed API (API Gateway invoke URL)
VITE_API_BASE_URL="https://your-api-id.execute-api.your-region.amazonaws.com"
